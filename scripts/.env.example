# Copier ce fichier en scripts/.env (jamais commité) et remplir les valeurs.

# Domaine technique de la boutique, PAS le domaine public. Exemple : ma-boutique.myshopify.com
SHOPIFY_STORE_DOMAIN=

# Version de l'API Admin. Choisir une version stable listée dans la documentation Shopify.
SHOPIFY_API_VERSION=2026-07

# Option A : token d'accès Admin API permanent (shpat_...), si vous en avez un.
SHOPIFY_ADMIN_TOKEN=

# Option B (cas normal depuis 2026) : identifiants de l'app créée dans le Dev Dashboard.
# Si SHOPIFY_ADMIN_TOKEN est vide, les scripts obtiennent un token valable 24 h avec ces deux valeurs.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
